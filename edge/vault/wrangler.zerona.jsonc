// Zerona/Prima vault deploy config (CI: `wrangler deploy -c wrangler.zerona.jsonc` from edge/vault).
// No HTTP surface: reached only via the edge Worker's VAULT service binding (VaultApi).
// Deploy zerona-vault before the edge worker so the binding resolves.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerona-vault",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "25385d7655b75ef9a68e19d17d940339",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      // dev1/{userId}: enrolled device keys, replay fences, audit log, the
      // per-user kill switch.
      { "name": "VAULT_DEVICES", "class_name": "VaultDevices" },
      // acct1/{userId}/{provider}: one encrypted credential + its refresh
      // bookkeeping. Single-threaded per id = one refresh in flight.
      { "name": "VAULT_ACCOUNTS", "class_name": "VaultAccount" },
      // conn1/{userId}: encrypted remote MCP / plugin connection configs and
      // auth material + single-flight OAuth refresh per connection id.
      { "name": "VAULT_CONNECTIONS", "class_name": "VaultConnections" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VaultDevices", "VaultAccount"] },
    { "tag": "v2", "new_sqlite_classes": ["VaultConnections"] }
  ],
  // Daily canary: force-refresh CANARY_USER_ID's codex + github credentials so
  // a provider changing its refresh contract alerts before users' grants fail.
  "triggers": { "crons": ["0 6 * * *"] },
  // No vars. Secrets (`wrangler secret put NAME`), see README.md:
  //   VAULT_KEK                 required; base64 of 32 random bytes (the KEK)
  //   VAULT_KEK_PREVIOUS        optional; the KEK before the last rotation
  //   GITHUB_APP_CLIENT_ID      GitHub App (user-to-server tokens, device flow)
  //   GITHUB_APP_CLIENT_SECRET
  //   GITHUB_APP_PRIVATE_KEY    optional; RS256 App JWT + installation tokens
  //   GITHUB_APP_SLUG           optional; e.g. zeron, for the install link
  //   ANTIGRAVITY_OAUTH_CLIENT_ID     optional; Antigravity OAuth refresh
  //   ANTIGRAVITY_OAUTH_CLIENT_SECRET
  //   VAULT_DISABLED            optional; "1" = global kill switch (every call 503)
  //   CANARY_USER_ID            optional; user whose credentials the cron refreshes
  "observability": {
    "enabled": true
  }
}